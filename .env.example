# ==============================================================================
# CRAVE APP ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Base URL của Website (dùng cho SEO, Canonical, Sitemap, Robots, OpenGraph)
# Khi chạy local: http://localhost:3000
# Khi đưa lên production: https://craveapp.vn (hoặc domain chính thức của bạn)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Mã xác minh Google Search Console (lấy từ Google Search Console khi xác minh web)
# Để trống nếu chưa có mã xác thực
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 3. Đường dẫn tải ứng dụng (cập nhật khi có link chính thức trên App Store / Google Play)
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/app/crave
NEXT_PUBLIC_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.crave.app
